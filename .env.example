PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/home-recipes?retryWrites=true&w=majority

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes in seconds (defaults: 15 minutes / 30 days), optional
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

CLOUDINARY_CLOUD_NAME=wurgqb8u
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# SMTP credentials for Nodemailer (see src/services/email.service.ts for why Nodemailer was chosen)
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# If true, login is blocked until the user confirms their email
REQUIRE_EMAIL_VERIFICATION=true

# Base URL of the frontend app, used to build the email verification link
APP_URL=http://localhost:5173
